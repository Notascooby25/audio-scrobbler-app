APP_ENV=development
APP_VERSION=0.2.4
ACCESS_TOKEN_TTL_SECONDS=3600
DEV_USER_ID=1
DEV_USER_SPOTIFY_ID=development-user
DEV_USER_DISPLAY_NAME=Development User
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
SPOTIFY_SCOPES=user-read-recently-played user-library-read
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/connect
# Comma-separated Spotify user IDs allowed to sign up or log in. Empty
# means unrestricted. Set this on any host reachable outside your
# LAN/tailnet (e.g. behind a Tailscale Funnel or similar public tunnel) —
# completing Spotify OAuth alone does not vet who should get an account.
ALLOWED_SPOTIFY_USER_IDS=
WORKER_SPOTIFY_ENABLED=false
# How often the worker checks which users are due for a recently-played
# poll — each user's actual cadence is their own poll_interval_minutes
# setting (default 5), not this value.
WORKER_SPOTIFY_INTERVAL_MINUTES=1
# How often the worker checks for liked-songs sync work (backfill progress
# or a due daily check), for users who've enabled it in Settings. Each tick
# fetches at most one page of 40 tracks per user.
WORKER_LIKED_TRACKS_INTERVAL_MINUTES=30
# How often the worker looks for playlist names it hasn't resolved yet
# (Reports > Playlists), and how many it resolves per tick. Low-priority
# background enrichment, not ingestion — deliberately slow and small-batch so
# a big backlog is spread across many ticks instead of bursting Spotify. This
# replaced an inline, un-throttled per-request Spotify call.
WORKER_PLAYLIST_CACHE_INTERVAL_MINUTES=15
WORKER_PLAYLIST_CACHE_BATCH_SIZE=10
# Worker log level. The worker calls logging.basicConfig() at import, so
# INFO-level sync progress actually reaches `docker logs`; before that it
# configured nothing and the root logger sat at WARNING, silently dropping
# every per-user sync result. Set to WARNING to quieten it again.
WORKER_LOG_LEVEL=INFO
# Optional file-drop import: the worker watches WORKER_IMPORT_HOST_DIR on
# the host for export files. Off by default. Enabling it also requires
# uncommenting the worker's volume mount in docker-compose.prod.yml.
WORKER_FILE_IMPORT_ENABLED=false
WORKER_FILE_IMPORT_INTERVAL_MINUTES=10
WORKER_IMPORT_HOST_DIR=
DATABASE_URL=postgresql+psycopg://scrobbler:scrobbler@db:5432/scrobbler
JWT_SECRET=change-me
REFRESH_TOKEN_KEY=0123456789abcdef0123456789abcdef
INGESTION_WORKER_URL=http://worker:8001
WORKER_INGESTION_TOKEN=dev-worker-token
CORS_ORIGINS=http://localhost:5173
GHCR_OWNER=notascooby25
IMAGE_TAG=latest
# Host path to the docker config dir holding GHCR login creds (from
# `docker login ghcr.io`), mounted read-only into the watchtower container
# so it can pull new :latest images on your behalf.
DOCKER_CONFIG_DIR=/home/youruser/.docker
WATCHTOWER_POLL_INTERVAL=300
# Watchtower's bundled Docker client otherwise negotiates down to an API
# version modern daemons reject outright ("client version 1.25 is too
# old"). Pinned rather than left to negotiation.
WATCHTOWER_DOCKER_API_VERSION=1.41
# Leave unset in production. The production frontend image (built from
# frontend/Dockerfile.prod) serves a static bundle where this would need
# to be baked in at build time to have any effect — it is not — and its
# nginx config already proxies API paths to the backend on the same
# origin. This var only matters for the dev-server frontend
# (docker-compose.yml), where it's read at request time.
VITE_API_BASE_URL=
# Comma-separated hostnames the Vite dev server will accept a Host header
# for (its DNS-rebinding protection). Only applies to the dev-server
# frontend in docker-compose.yml — set it when reaching that through a
# tunnel or reverse proxy, e.g. a Tailscale Funnel hostname. The
# production image serves static files via nginx and ignores this.
VITE_ALLOWED_HOSTS=
# Host port the backend is published on. Defaults to 8000; override it on
# a shared host where something else already owns that port.
BACKEND_HOST_PORT=8000
PROMETHEUS_RETENTION=14d
ALERTMANAGER_CRITICAL_WEBHOOK_URL=http://127.0.0.1:65535/disabled
ALERTMANAGER_WARNING_WEBHOOK_URL=http://127.0.0.1:65535/disabled
POSTGRES_DB=scrobbler
POSTGRES_USER=scrobbler
POSTGRES_PASSWORD=replace-me

# ─── Backups (scripts/backup_database.sh, scripts/verify_database_backup.sh)
# Where dumps are written, relative to the deploy directory unless absolute.
BACKUP_DIR=backups
# Days of local dumps to keep. Offsite copies are pruned separately, by
# GDRIVE_RETENTION_DAYS.
BACKUP_RETENTION_DAYS=3
# rclone remote used for the offsite copy, and how long to keep dumps
# there. Point GDRIVE_REMOTE_NAME at an rclone *crypt* remote (see
# guides/google-drive-backup-setup.md): dumps hold the full listening history
# and should not sit in Drive in plaintext. The script's built-in fallback is
# the plain `gdrive` remote, so an unset or mistyped value uploads UNENCRYPTED.
# If rclone isn't installed the upload is skipped and the offsite staleness
# alert will fire. A second copy of the dumps reaches the NAS through the
# sleepwell repo's whole-/srv mirror; nothing to configure here for that.
GDRIVE_REMOTE_NAME=gdrive-crypt
GDRIVE_RETENTION_DAYS=30
# Restore verification fails if the restored listening_events count is
# below this fraction of the live database's. Guards against a dump that
# restores cleanly but is missing most of its rows.
BACKUP_MIN_RESTORED_FRACTION=0.5
# The backup timer's own heartbeat/dead-man's-switch URL is configured
# separately, per-host — see scripts/systemd/audio-scrobbler-backup.env.example.
