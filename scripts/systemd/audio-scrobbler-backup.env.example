# Copy this file to audio-scrobbler-backup.env (same directory) and fill in
# values. It is loaded by audio-scrobbler-backup.service via EnvironmentFile
# and is NOT tracked by git (see .gitignore) since it may carry a private
# heartbeat URL.

# Where scrobbler-*.dump files are written. Point this at the same directory
# your other host-level backup jobs (rclone-to-Drive, Synology push, etc.)
# already sweep, so this app's dumps get the same offsite coverage as the
# rest of the host's apps instead of being the one thing left uncovered.
BACKUP_DIR=/srv/shared/backups/audio-scrobbler

# Dead-man's-switch / heartbeat base URL (e.g. a healthchecks.io check UUID
# URL: https://hc-ping.com/<uuid>). On success the script GETs this URL as-is;
# on failure it GETs "<url>/fail". Leave unset to disable heartbeat pings.
#HEARTBEAT_URL=https://hc-ping.com/replace-with-your-check-uuid
